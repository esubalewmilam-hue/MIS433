      "source": [
        "# Find the top 3 highest rated movies of each year since 2010.\n",
        "# Show their released year, ranking, title, and IMDB_Rating.\n",
        "# Sort them in descending order of year and ascending order of ranking\n",
        "#chatgpt created\n",
        "top_movies_by_year = imdb.loc[\n",
        "    imdb['Released_Year'] >= 2010,\n",
        "    ['Released_Year', 'Series_Title', 'IMDB_Rating']\n",
        "].copy()\n",
        "\n",
        "top_movies_by_year['Ranking'] = top_movies_by_year.groupby(\n",
        "    'Released_Year'\n",
        ")['IMDB_Rating'].rank(method='first', ascending=False)\n",
        "\n",
        "top_movies_by_year['Ranking'] = top_movies_by_year['Ranking'].astype(int)\n",
        "\n",
        "top_movies_by_year = top_movies_by_year.loc[\n",
        "    top_movies_by_year['Ranking'] <= 3,\n",
        "    ['Released_Year', 'Ranking', 'Series_Title', 'IMDB_Rating']\n",
        "].sort_values(['Released_Year', 'Ranking'], ascending=[False, True])\n",
        "\n",
        "top_movies_by_year"
